# generated by heypcb from design.json net classes
(version 1)

(rule "heypcb:pads inside one JLC land"
  (constraint clearance (min 0.1mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == B.Parent && A.memberOfFootprint('HeyPCB_LCSC:*')"))

(rule "heypcb:USB:skew"
  (constraint skew (max 1.25mm) (within_diff_pairs))
  (severity warning)
  (condition "A.hasNetclass('USB')"))
